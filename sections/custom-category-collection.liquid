<section class="category-section">
  <div class="custom-container">

    <div class="category-wrapper">

      {% for block in section.blocks %}

        <a href="{{ block.settings.category_link }}" class="category-item">

          <div class="category-icon">

            {% if block.settings.category_icon != blank %}

              <img 
                src="{{ block.settings.category_icon | image_url }}"
                alt="{{ block.settings.category_title }}"
                width="100"
                height="100">

            {% endif %}

          </div>

          <h4>{{ block.settings.category_title }}</h4>

        </a>

      {% endfor %}

    </div>

  </div>
</section>



<style>

.category-section {
    padding:90px 0px
  
}

.custom-container {
  max-width: 1320px;
  margin: 0 auto;
  padding: 0 15px;
}

.category-wrapper {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: {{ section.settings.item_gap }}px;
  flex-wrap: wrap;
}

.category-item {
  text-align: center;
  text-decoration: none;
}

.category-icon {
  width: {{ section.settings.box_size }}px;
  height: {{ section.settings.box_size }}px;
  border-radius: {{ section.settings.border_radius }}px;
  background: {{ section.settings.icon_bg }};
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 10px;
  transition: 0.3s ease;
  padding: 18px;
}

.category-icon img {
  width: {{ section.settings.icon_size }}%;
  height: {{ section.settings.icon_size }}%;
  object-fit: contain;
} 

.category-item h4 {
  margin: 0;
  font-size: {{ section.settings.text_size }}px;
  font-weight: 500;
  color: {{ section.settings.text_color }};
}

.category-item:hover .category-icon {
  transform: translateY(-5px);
  background: {{ section.settings.hover_bg }};
}


@media screen and (max-width: 768px) {

  .category-wrapper {
    gap: 20px;
    justify-content: flex-start;
    overflow-x: auto;
    flex-wrap: nowrap;
    padding-bottom: 10px;
  }

  .category-item {
    min-width: 90px;
  }

  .category-icon {
    width: 70px;
    height: 70px;
    padding: 12px;
  }

}

</style>



{% schema %}
{
  "name": "Category Collection",
  "settings": [

    {
      "type": "color",
      "id": "section_bg",
      "label": "Section Background",
      "default": "#ffffff"
    },

    {
      "type": "color",
      "id": "icon_bg",
      "label": "Icon Background",
      "default": "#f5f5f5"
    },

    {
      "type": "color",
      "id": "hover_bg",
      "label": "Hover Background",
      "default": "#ffe8df"
    },

    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#111111"
    },

    {
      "type": "range",
      "id": "box_size",
      "label": "Box Size",
      "min": 60,
      "max": 160,
      "step": 2,
      "default": 100
    },

    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon Size (%)",
      "min": 40,
      "max": 100,
      "step": 5,
      "default": 75
    },

    {
      "type": "range",
      "id": "border_radius",
      "label": "Border Radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "default": 28
    },

    {
      "type": "range",
      "id": "item_gap",
      "label": "Items Gap",
      "min": 5,
      "max": 60,
      "step": 1,
      "default": 25
    },

    {
      "type": "range",
      "id": "text_size",
      "label": "Text Size",
      "min": 10,
      "max": 30,
      "step": 1,
      "default": 13
    },

    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 30
    },

    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 30
    }

  ],


  "blocks": [

    {
      "type": "category",
      "name": "Category",
      "settings": [

        {
          "type": "image_picker",
          "id": "category_icon",
          "label": "Category Icon"
        },

        {
          "type": "text",
          "id": "category_title",
          "label": "Category Title",
          "default": "Footwear"
        },

        {
          "type": "url",
          "id": "category_link",
          "label": "Category Link"
        }

      ]
    }

  ],


  "presets": [
    {
      "name": "Category Collection",
      "blocks": [
        {
          "type": "category"
        },
        {
          "type": "category"
        },
        {
          "type": "category"
        },
        {
          "type": "category"
        }
      ]
    }
  ]

}
{% endschema %}