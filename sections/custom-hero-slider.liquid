<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/kenwheeler/slick@1.8.1/slick/slick.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/kenwheeler/slick@1.8.1/slick/slick-theme.css">
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/gh/kenwheeler/slick@1.8.1/slick/slick.min.js"></script>

<style>
  :root {
    --primary-color: #ff5c35;
    --bg-color: #f9f1ee;
  }

  .hero-slider-wrapper {
    background: var(--bg-color);
    padding: 80px 0;
    overflow: hidden;
    width: 100%;
    position: relative;
  }

  .slider-container {
    width: 1320px;
    margin: 0 auto;
    padding: 0 60px;
    position: relative;
  }

  .slide {
    display: flex !important;
    align-items: center;
    justify-content: space-between;
    outline: none;
    gap: 40px;
  }

  /* Content Styling */
  .content {
    flex: 1;
    max-width: 550px;
    text-align: left;
  }

  .badge-top {
    background: var(--primary-color);
    color: #fff;
    padding: 6px 16px;
    border-radius: 50px;
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 25px;
    display: inline-block;
  }

  .content h1 {
    font-size: 56px;
    font-weight: 800;
    line-height: 1.1;
    color: #1a1a1a;
    margin: 0 0 20px 0;
  }

  .content h1 span {
    color: var(--primary-color);
  }

  .content p {
    font-size: 18px;
    color: #555;
    line-height: 1.4;
    margin-bottom: 35px;
  }

  /* Buttons */
  .button-group {
    display: flex;
    gap: 15px;
  }

  .btn-primary {
    background: var(--primary-color);
    color: #fff;
    padding: 15px 35px;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 600;
    border: none;
  }

  .btn-secondary {
    border: 2px solid #1a1a1a;
    color: #1a1a1a;
    padding: 15px 35px;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 600;
  }

  /* Image Section */
  .image-wrapper {
    flex: 1;
    display: flex;
    justify-content: flex-end;
    position: relative;
  }

  .main-img-card img {
    max-width: 380px;
    width: 100%;
    height: auto;
    display: block;
    border-radius: 20px;
  }

  /* Floating Badges */
  .float-badge {
    position: absolute;
    background: #fff;
    padding: 8px 15px;
    border-radius: 12px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.1);
    font-size: 14px;
    font-weight: 700;
    white-space: nowrap;
    z-index: 5;
  }
  .rating-badge { top: 65px; right: 10px; }
  .offer-badge { bottom: 90px; left: 160px; }

  /* Navigation Arrows */
  .slick-prev, .slick-next {
    width: 50px;
    height: 50px;
    background: #fff !important;
    border-radius: 50%;
    z-index: 10;
    box-shadow: 0 5px 15px rgba(0,0,0,0.15);
  }
  .slick-prev { left: -75px; }
  .slick-next { right: -75px; }
  .slick-prev:before, .slick-next:before {
    color: #000;
    font-size: 24px;
    opacity: 1;
  }

  /* Pagination Dots */
  .slick-dots { bottom: -60px; }
  .slick-dots li button:before { display: none; }
  .slick-dots li button {
    width: 10px;
    height: 10px;
    background: #ccc;
    border-radius: 50%;
    padding: 0;
  }
  .slick-dots li.slick-active button {
    background: var(--primary-color);
    width: 25px;
    border-radius: 10px;
  }

  /* Responsive Fixes */
  @media (max-width: 991px) {
    .content h1 { font-size: 42px; }
    .main-img-card img { max-width: 300px; }
  }

  @media (max-width: 768px) {
    .slide { flex-direction: column; text-align: center; }
    .content { text-align: center; max-width: 100%; }
    .button-group { justify-content: center; }
    .image-wrapper { justify-content: center; margin-top: 40px; }
    .float-badge { font-size: 12px; }
    .slick-prev { left: 0; }
    .slick-next { right: 0; }
  }
</style>

<section class="hero-slider-wrapper">
  <div class="slider-container">
    <div id="hero-slider-{{ section.id }}">
      {% for block in section.blocks %}
      <div class="slide" {{ block.shopify_attributes }}>
        <div class="content">
          <span class="badge-top">{{ block.settings.badge }}</span>
          <h1>Step Into <span>Style</span><br/> This Season</h1>
          <p>{{ block.settings.text }}</p>
          <div class="button-group">
            <a href="{{ block.settings.btn_link }}" class="btn-primary">{{ block.settings.btn_text }}</a>
            <a href="#" class="btn-secondary">View Lookbook</a>
          </div>
        </div>

        <div class="image-wrapper">
          <div class="main-img-card">
            <div class="float-badge rating-badge">⭐ 4.9 Rating</div>
            <div class="float-badge offer-badge">🔥 50% OFF Today!</div>
            {% if block.settings.image %}
              <img src="{{ block.settings.image | image_url: width: 800 }}" alt="Slider Image">
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
          </div>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<script>
  $(document).ready(function(){
    var $slider = $('#hero-slider-{{ section.id }}');
    if($slider.length) {
      $slider.slick({
        dots: true,
        arrows: true,
        autoplay: true,
        autoplaySpeed: 3000,
        infinite: true,
        speed: 800,
        slidesToShow: 1,
        slidesToScroll: 1,
        rows: 0,
        adaptiveHeight: true
      });
    }
  });
</script>

{% schema %}
{
  "name": "Hero Slider Final",
  "settings": [],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "text", "id": "badge", "label": "Badge", "default": "New Season 2025" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Step Into Style" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Discover the latest collection of premium sneakers." },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Shop Now" },
        { "type": "url", "id": "btn_link", "label": "Button Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Slider Final",
      "blocks": [ { "type": "slide" } ]
    }
  ]
}
{% endschema %}