<style>
  .custom-footer {
    background-color: #1a1a1a;
    color: #ffffff;
    padding: 80px 0 40px;
    font-family: 'Poppins', sans-serif;
  }
  .container {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr 0.8fr 1.2fr;
    gap: 40px;
    margin-bottom: 60px;
  }
  .footer-logo h2 {
    font-size: 28px;
    font-weight: 700;
    margin: 0 0 20px;
  }
  .footer-logo h2 span { color: #ff5c35; }
  .footer-logo p {
    color: #a0a0a0;
    font-size: 14px;
    line-height: 1.6;
    margin-bottom: 25px;
  }
  .social-icons { display: flex; gap: 12px; }
  .social-icon {
    width: 35px;
    height: 35px;
    background: #333;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    color: #fff;
    text-decoration: none;
    transition: 0.3s;
  }
  .social-icon:hover { background: #ff5c35; }
  
  .footer-heading {
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 25px;
    color: #fff;
  }
  .footer-links { list-style: none; padding: 0; margin: 0; }
  .footer-links li { margin-bottom: 12px; }
  .footer-links a {
    color: #a0a0a0;
    text-decoration: none;
    font-size: 14px;
    transition: 0.3s;
  }
  .footer-links a:hover { color: #ff5c35; padding-left: 5px; }

  /* Newsletter */
  .newsletter-text { color: #a0a0a0; font-size: 14px; margin-bottom: 20px; }
  .newsletter-form { display: flex; gap: 10px; margin-bottom: 15px; }
  .newsletter-input {
    flex: 1;
    background: #333;
    border: 1px solid #444;
    padding: 12px 15px;
    border-radius: 8px;
    color: #fff;
    font-size: 14px;
  }
  .newsletter-btn {
    background: #ff5c35;
    color: #fff;
    border: none;
    padding: 0 25px;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
  }
  .newsletter-note { font-size: 11px; color: #666; display: flex; align-items: center; gap: 5px; }

  /* Bottom Bar */
  .footer-bottom {
    border-top: 1px solid #333;
    padding-top: 30px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
  }
  .copyright { color: #666; font-size: 13px; }
  .payment-methods { display: flex; gap: 8px; }
  .payment-badge {
    background: #333;
    padding: 4px 12px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    color: #a0a0a0;
    text-transform: uppercase;
  }

  @media (max-width: 991px) {
    .footer-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 600px) {
    .footer-grid { grid-template-columns: 1fr; }
    .footer-bottom { flex-direction: column; text-align: center; }
  }
</style>

<footer class="custom-footer">
  <div class="container">
    <div class="footer-grid">
      
      <div class="footer-col">
        <div class="footer-logo">
          <h2>{{ section.settings.logo_text_1 }}<span>{{ section.settings.logo_text_2 }}</span></h2>
          <p>{{ section.settings.about_text }}</p>
          <div class="social-icons">
            <a href="#" class="social-icon">f</a>
            <a href="#" class="social-icon">𝕏</a>
            <a href="#" class="social-icon">in</a>
            <a href="#" class="social-icon">📷</a>
          </div>
        </div>
      </div>

      <div class="footer-col">
        <h4 class="footer-heading">{{ section.settings.menu_1_title }}</h4>
        <ul class="footer-links">
          {% for link in section.settings.menu_1.links %}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {% endfor %}
        </ul>
      </div>

      <div class="footer-col">
        <h4 class="footer-heading">{{ section.settings.menu_2_title }}</h4>
        <ul class="footer-links">
          {% for link in section.settings.menu_2.links %}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {% endfor %}
        </ul>
      </div>

      <div class="footer-col">
        <h4 class="footer-heading">Newsletter</h4>
        <p class="newsletter-text">{{ section.settings.newsletter_text }}</p>
        {% form 'customer', class: 'newsletter-form' %}
          <input type="email" name="contact[email]" class="newsletter-input" placeholder="Your email address" required>
          <button type="submit" class="newsletter-btn">Subscribe</button>
        {% endform %}
        <div class="newsletter-note">🔒 {{ section.settings.newsletter_note }}</div>
      </div>

    </div>

    <div class="footer-bottom">
      <div class="copyright">
        &copy; {{ 'now' | date: "%Y" }} {{ section.settings.copyright_text }}
      </div>
      <div class="payment-methods">
        <span class="payment-badge">UPI</span>
        <span class="payment-badge">VISA</span>
        <span class="payment-badge">MC</span>
        <span class="payment-badge">AMEX</span>
        <span class="payment-badge">RUPAY</span>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Custom Dark Footer",
  "settings": [
    { "type": "text", "id": "logo_text_1", "label": "Logo Part 1", "default": "Shop" },
    { "type": "text", "id": "logo_text_2", "label": "Logo Part 2", "default": "Zone" },
    { "type": "textarea", "id": "about_text", "label": "About Text", "default": "Your one-stop destination for premium fashion, electronics, and lifestyle products. Quality you can trust." },
    { "type": "text", "id": "menu_1_title", "label": "Menu 1 Title", "default": "Quick Links" },
    { "type": "link_list", "id": "menu_1", "label": "Select Menu 1" },
    { "type": "text", "id": "menu_2_title", "label": "Menu 2 Title", "default": "Customer Care" },
    { "type": "link_list", "id": "menu_2", "label": "Select Menu 2" },
    { "type": "textarea", "id": "newsletter_text", "label": "Newsletter Text", "default": "Get exclusive deals and latest trends delivered to your inbox." },
    { "type": "text", "id": "newsletter_note", "label": "Newsletter Note", "default": "No spam. Unsubscribe anytime." },
    { "type": "text", "id": "copyright_text", "label": "Copyright Text", "default": "ShopZone. All rights reserved. Made with ❤️ in India." }
  ],
  "presets": [{ "name": "Custom Dark Footer" }]
}
{% endschema %}