<header class="custom-header">
  <div class="page-width custom-container header-wrapper">

    <!-- Mobile Menu Button -->
    <button class="menu-toggle" id="menu-toggle">
      ☰
    </button>

    <!-- Logo -->
    <div class="header-logo">
      {% if section.settings.logo != blank %}
        <a href="{{ routes.root_url }}">
          <img
            src="{{ section.settings.logo | image_url }}"
            alt="Logo"
            width="160"
            height="auto"
          >
        </a>
      {% else %}
        <h2>{{ shop.name }}</h2>
      {% endif %}
    </div>

    <!-- Navigation -->
    <nav class="header-nav" id="mobile-menu">
      <ul>
        {% for link in linklists[section.settings.menu].links %}
          <li>
            <a href="{{ link.url }}">{{ link.title }}</a>
          </li>
        {% endfor %}
      </ul>
    </nav>

    <!-- Right Side -->
    <div class="header-right">
      {% if section.settings.show_search %}
        <form action="/search" method="get" class="header-search">
          <input
            type="text"
            name="q"
            placeholder="Search products..."
          >
        </form>
      {% endif %}

      <a href="/account" class="header-btn">
        {{ section.settings.button_text }}
      </a>
    </div>
  </div>
</header>

<style>

  *{
    box-sizing:border-box;
  }

  .custom-container {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 15px;
  }

  .custom-header {
    background: {{ section.settings.bg_color }};
    padding: 16px 0;
    border-bottom: 1px solid #eee;
    position: relative;
  }

  .header-wrapper {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
    position: relative;
  }

  /* LOGO */
  .header-logo {
    flex-shrink: 0;
  }

  .header-logo img {
    max-width: 160px;
    width: 100%;
    height: auto;
    display: block;
  }

  /* NAVIGATION */
  .header-nav {
    flex: 1;
    display: flex;
    justify-content: center;
  }

  .header-nav ul {
    display: flex;
    align-items: center;
    gap: 25px;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }

  .header-nav a {
    text-decoration: none;
    color: {{ section.settings.text_color }};
    font-size: 15px;
    font-weight: 500;
    transition: 0.3s ease;
    white-space: nowrap;
  }

  .header-nav a:hover {
    color: {{ section.settings.accent_color }};
  }

  /* RIGHT SIDE */
  .header-right {
    display: flex;
    align-items: center;
    gap: 15px;
    flex-shrink: 0;
  }

  .header-search {
    width: 100%;
  }

  .header-search input {
    padding: 10px 14px;
    border-radius: 30px;
    border: 1px solid #ddd;
    outline: none;
    width: 220px;
    max-width: 100%;
    font-size: 14px;
  }

  .header-btn {
    background: {{ section.settings.button_bg }};
    color: {{ section.settings.button_text_color }};
    padding: 10px 22px;
    border-radius: 30px;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    transition: 0.3s ease;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .header-btn:hover {
    opacity: 0.9;
  }

  /* MOBILE MENU BUTTON */
  .menu-toggle {
    display: none;
    background: transparent;
    border: none;
    font-size: 28px;
    cursor: pointer;
    color: {{ section.settings.text_color }};
    padding: 0;
    line-height: 1;
  }

  /* LARGE TABLET */
  @media screen and (max-width: 1024px) {

    .header-wrapper {
      gap: 15px;
    }

    .header-nav ul {
      gap: 15px;
    }

    .header-search input {
      width: 180px;
    }
  }

  /* TABLET */
  @media screen and (max-width: 768px) {

    .custom-header {
      padding: 14px 0;
    }

    .header-wrapper {
      flex-wrap: wrap;
      gap: 15px;
    }

    .menu-toggle {
      display: block;
      order: 1;
    }

    .header-logo {
      order: 2;
      flex: 1;
      text-align: center;
    }

    .header-logo img {
      margin: 0 auto;
      max-width: 130px;
    }

    .header-right {
      order: 3;
      margin-left: auto;
    }

    /* MOBILE NAV */
    .header-nav {
      order: 4;
      width: 100%;
      display: none;
      justify-content: flex-start;
    }

    .header-nav.active {
      display: flex;
    }

    .header-nav ul {
      width: 100%;
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
      padding-top: 15px;
    }

    .header-nav li {
      width: 100%;
    }

    .header-nav a {
      display: block;
      width: 100%;
      font-size: 16px;
    }

    /* MOBILE RIGHT */
    .header-right {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
    }

    .header-search input {
      width: 100%;
    }

    .header-btn {
      width: 100%;
      text-align: center;
    }
  }

  /* SMALL MOBILE */
  @media screen and (max-width: 480px) {

    .custom-container {
      padding: 0 12px;
    }

    .header-logo img {
      max-width: 110px;
    }

    .header-search input {
      padding: 9px 12px;
      font-size: 13px;
    }

    .header-btn {
      padding: 10px 16px;
      font-size: 13px;
    }

    .header-nav a {
      font-size: 15px;
    }
  }

</style>

<script>
  document.addEventListener("DOMContentLoaded", function () {

    const toggleBtn = document.getElementById("menu-toggle");
    const mobileMenu = document.getElementById("mobile-menu");

    toggleBtn.addEventListener("click", function () {
      mobileMenu.classList.toggle("active");
    });

  });
</script>

{% schema %}
{
  "name": "Custom Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },

    {
      "type": "link_list",
      "id": "menu",
      "label": "Select Menu"
    },

    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show Search Bar",
      "default": true
    },

    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Sign In"
    },

    {
      "type": "color",
      "id": "bg_color",
      "label": "Header Background",
      "default": "#ffffff"
    },

    {
      "type": "color",
      "id": "text_color",
      "label": "Menu Text Color",
      "default": "#111111"
    },

    {
      "type": "color",
      "id": "accent_color",
      "label": "Hover Color",
      "default": "#ff6b35"
    },

    {
      "type": "color",
      "id": "button_bg",
      "label": "Button Background",
      "default": "#ff6b35"
    },

    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    }
  ],

  "presets": [
    {
      "name": "Custom Header"
    }
  ]
}
{% endschema %}